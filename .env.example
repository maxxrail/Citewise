# Copy to .env and fill in. Never commit .env.
# mock = offline fixtures, no cost (default). live = real API calls.
CITEWISE_MODE=mock

DATABASE_URL=postgresql+psycopg://citewise:citewise@localhost:5432/citewise

# Answer engines + LLMs (needed only in live mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Model IDs per purpose. Module 0/2 fills defaults after checking current provider docs.
MODEL_EXTRACT=
MODEL_JUDGE=
MODEL_GENERATE=
MODEL_EMBED=
ENGINE_MODEL_OPENAI=
ENGINE_MODEL_ANTHROPIC=
ENGINE_MODEL_GEMINI=
ENGINE_MODEL_PERPLEXITY=

# Cost guard
MAX_COST_USD_PER_RUN=3.00

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
