# Copy to .env and fill in. Never commit .env.
# mock = offline fixtures, no cost (default). live = real API calls.
CITEWISE_MODE=mock

DATABASE_URL=postgresql+psycopg://citewise:citewise@localhost:5432/citewise

# Host ports for docker compose (change if 5432/8000 are already used, and match DATABASE_URL)
CITEWISE_DB_PORT=5432
CITEWISE_API_PORT=8000

# API keys (needed only in live mode). ANTHROPIC_API_KEY runs everything Citewise does
# itself; the others are needed only to scan that engine (--engines openai,gemini,...).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Who runs Citewise's own LLM calls and embeddings (see README "Live mode").
# Anthropic has no embeddings API, so embeddings default to a free local model.
LLM_PROVIDER=anthropic
EMBED_PROVIDER=local

# Model IDs per purpose (checked 2026-11-24). Leave blank to use the defaults in
# src/citewise/core/config.py. They must match LLM_PROVIDER: for LLM_PROVIDER=openai use
# e.g. gpt-6-luna / gpt-6.2-sol; for EMBED_PROVIDER=openai use text-embedding-3-small.
MODEL_EXTRACT=claude-haiku-5-5
MODEL_JUDGE=claude-haiku-5-5
MODEL_GENERATE=claude-opus-5-5
MODEL_EMBED=BAAI/bge-small-en-v1.5

# Answer engines being measured (one key each, above).
ENGINE_MODEL_OPENAI=gpt-6-luna
ENGINE_MODEL_ANTHROPIC=claude-haiku-5-5
ENGINE_MODEL_GEMINI=gemini-3.5-flash-lite
ENGINE_MODEL_PERPLEXITY=perplexity/sonar
SCAN_MAX_OUTPUT_TOKENS={"openai":6000,"anthropic":4096,"gemini":3000,"perplexity":2500}

# Cost guard
MAX_COST_USD_PER_RUN=3.00

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Prompt panel (Module 1). All optional; the defaults shown are what you get if unset. ---
# PANEL_PROMPTS_PER_CELL=20      # prompts per (intent x persona) generation call; 15 calls per brand
# PANEL_DEDUP_THRESHOLD=0.92     # cosine above which two prompts count as near-duplicates
# PANEL_K_MIN=6                  # range of topic counts the silhouette search tries
# PANEL_K_MAX=14
# PANEL_PCA_DIMS=20              # dimensions to reduce to before clustering (0 = raw embeddings)
# PANEL_CLASSIFY_BATCH=25        # prompts per intent-classification call
# PANEL_IMPORT_MAX_ROWS=5000     # max rows accepted by `citewise panel import`
# PANEL_SILHOUETTE_SAMPLE=2000   # above this many prompts, silhouette uses a sample
# PROMPTS_DIR=                   # prompt templates folder (default: ./prompts)

# --- Extraction and metrics (Module 3). Optional. ---
# EXTRACT_CONCURRENCY=4          # parallel Stage B calls in live mode
# METRICS_BOOTSTRAP=1000         # bootstrap resamples for confidence intervals (max 5000)
