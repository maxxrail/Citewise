# Copy to .env and fill in. Never commit .env.
# mock = offline fixtures, no cost (default). live = real API calls.
CITEWISE_MODE=mock

DATABASE_URL=postgresql+psycopg://citewise:citewise@localhost:5432/citewise

# Host ports for docker compose (change if 5432/8000 are already used, and match DATABASE_URL)
CITEWISE_DB_PORT=5432
CITEWISE_API_PORT=8000

# Answer engines + LLMs (needed only in live mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Model IDs per purpose (defaults checked against provider docs 2026-11-23).
# Leave blank to use the defaults in src/citewise/core/config.py.
MODEL_EXTRACT=gpt-6-luna
MODEL_JUDGE=gpt-6-luna
MODEL_GENERATE=gpt-6.2-sol
MODEL_EMBED=text-embedding-3-small
ENGINE_MODEL_OPENAI=gpt-6-luna
ENGINE_MODEL_ANTHROPIC=claude-haiku-5-5
ENGINE_MODEL_GEMINI=gemini-3.5-flash-lite
ENGINE_MODEL_PERPLEXITY=perplexity/sonar

# Cost guard
MAX_COST_USD_PER_RUN=3.00

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Prompt panel (Module 1). All optional; the defaults shown are what you get if unset. ---
# PANEL_PROMPTS_PER_CELL=20      # prompts per (intent x persona) generation call; 15 calls per brand
# PANEL_DEDUP_THRESHOLD=0.92     # cosine above which two prompts count as near-duplicates
# PANEL_K_MIN=6                  # range of topic counts the silhouette search tries
# PANEL_K_MAX=14
# PANEL_PCA_DIMS=20              # dimensions to reduce to before clustering (0 = raw embeddings)
# PANEL_CLASSIFY_BATCH=25        # prompts per intent-classification call
# PANEL_IMPORT_MAX_ROWS=5000     # max rows accepted by `citewise panel import`
# PANEL_SILHOUETTE_SAMPLE=2000   # above this many prompts, silhouette uses a sample
# PROMPTS_DIR=                   # prompt templates folder (default: ./prompts)
